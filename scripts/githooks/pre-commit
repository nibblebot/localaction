#!/bin/sh
# pre-commit: fast checks only (~2s). The full gate runs on pre-push.
# Installed by `bun run setup:hooks` (auto-run from postinstall on `bun install`).
# Bypass in an emergency with `git commit --no-verify`.
set -eu

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

echo "pre-commit: 1/2 bun run lint"
bun run lint

echo "pre-commit: 2/2 bun test"
bun test

echo "pre-commit: OK"
