{
  "name": "localaction",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "tsc -b && bun --bun vite build",
    "lint": "oxlint",
    "preview": "bun --bun vite preview --configLoader runner",
    "start": "bun server/index.ts",
    "smoke": "bun scripts/smoke.ts",
    "backup-db": "bun scripts/backup-db.ts",
    "benchmark-size": "bun scripts/benchmark-size.ts",
    "test": "bun test",
    "test:unit": "bun test tests/data tests/markdown tests/router.test.ts",
    "test:integration": "bun test tests/integration/",
    "test:watch": "bun test --watch",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:offline": "bun run build && playwright test --config playwright.offline.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "env-paths": "^4.0.0",
    "markdown-it": "^14.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tinybase": "^9.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@playwright/test": "^1.61.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "^1.3.14",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
