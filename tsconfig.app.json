{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ES2023", "ES2024.Promise", "DOM"],
    "module": "esnext",
    "types": ["vite/client", "node", "bun"],
    "allowArbitraryExtensions": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "jsx": "react-jsx"
  },
  "include": ["src", "tests"]
}
